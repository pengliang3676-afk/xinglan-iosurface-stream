<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jibeib.xlstreamd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/XLStream.app/bin/xlstreamd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>3</integer>
    <key>UserName</key>
    <string>root</string>
    <key>POSIXSpawnType</key>
    <string>App</string>
    <key>HighPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/mobile/Media/XLStream.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/Media/XLStream.stderr.log</string>
</dict>
</plist>
