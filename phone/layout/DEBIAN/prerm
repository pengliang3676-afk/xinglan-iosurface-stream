#!/bin/sh

run_bounded() {
    limit="$1"
    shift
    "$@" >/dev/null 2>&1 &
    command_pid=$!
    (
        sleep "$limit"
        kill -TERM "$command_pid" >/dev/null 2>&1 || true
    ) &
    watchdog_pid=$!
    status=0
    wait "$command_pid" || status=$?
    kill "$watchdog_pid" >/dev/null 2>&1 || true
    wait "$watchdog_pid" >/dev/null 2>&1 || true
    return "$status"
}

if [ -x /Applications/XLStream.app/XLStreamLauncher ]; then
    PREFIX=""
else
    PREFIX="/var/jb"
fi
PLIST="${PREFIX}/Library/LaunchDaemons/com.jibeib.xlstreamd.plist"
run_bounded 3 launchctl bootout system/com.jibeib.xlstreamd || true
run_bounded 3 launchctl unload "$PLIST" || true
killall XLStreamLauncher >/dev/null 2>&1 || true
killall xlstreamd >/dev/null 2>&1 || true
exit 0
