#!/bin/sh
set -e

PLIST="/Library/LaunchDaemons/com.jibeib.xlstreamd.plist"
APP="/Applications/XLStream.app"
launchctl bootout system/com.jibeib.xlstreamd >/dev/null 2>&1 || true
killall XLStreamLauncher >/dev/null 2>&1 || true
killall xlstreamd >/dev/null 2>&1 || true
chown -R root:wheel "$APP" >/dev/null 2>&1 || true
chmod 755 "$APP" "$APP/XLStreamLauncher" "$APP/bin" "$APP/bin/xlstreamd" >/dev/null 2>&1 || true
if [ -x /rootfs/usr/bin/uicache ]; then
    /rootfs/usr/bin/uicache -p "$APP" >/dev/null 2>&1 || true
elif command -v uicache >/dev/null 2>&1; then
    uicache -p "$APP" >/dev/null 2>&1 || true
fi
launchctl bootstrap system "$PLIST" >/dev/null 2>&1 || launchctl load "$PLIST" >/dev/null 2>&1 || true
launchctl kickstart -k system/com.jibeib.xlstreamd >/dev/null 2>&1 || true
exit 0
