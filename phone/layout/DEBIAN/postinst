#!/bin/sh
set -e

if [ -x /Applications/XLStream.app/XLStreamLauncher ]; then
    PREFIX=""
else
    PREFIX="/var/jb"
fi
PLIST="${PREFIX}/Library/LaunchDaemons/com.jibeib.xlstreamd.plist"
APP="${PREFIX}/Applications/XLStream.app"
chown -R root:wheel "$APP" >/dev/null 2>&1 || true
chmod 755 "$APP" "$APP/XLStreamLauncher" "$APP/bin" "$APP/bin/xlstreamd" >/dev/null 2>&1 || true
# Dopamine's launchctl may block while dpkg/Sileo is configuring a package.
# Restart the service after dpkg exits so installation never hangs at Configuring.
(
    launchctl bootout system/com.jibeib.xlstreamd || true
    killall XLStreamLauncher || true
    killall xlstreamd || true
    sleep 1
    launchctl bootstrap system "$PLIST" || launchctl load "$PLIST" || true
) </dev/null >/dev/null 2>&1 &
exit 0
