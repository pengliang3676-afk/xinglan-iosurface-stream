#!/bin/sh

if [ -x /Applications/XLStream.app/XLStreamLauncher ]; then
    PREFIX=""
else
    PREFIX="/var/jb"
fi
APP="${PREFIX}/Applications/XLStream.app"
chown -R root:wheel "$APP" >/dev/null 2>&1 || true
chmod 755 "$APP" "$APP/XLStreamLauncher" "$APP/bin" "$APP/bin/xlstreamd" >/dev/null 2>&1 || true
# RootHide can leave launchctl bootout/bootstrap blocked forever.  Package
# scripts must never call launchctl.  On upgrades the already-loaded KeepAlive
# job restarts the new binary after these signals.  A first installation is
# activated by a userspace reboot or by opening XLStream once.
killall XLStreamLauncher >/dev/null 2>&1 || true
killall xlstreamd >/dev/null 2>&1 || true
exit 0
